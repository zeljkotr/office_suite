@router.post("/calculate")
def calculate(data: dict, db: Session = Depends(get_db), user: User = Depends(get_current_user)):
    data = payload_dict(data)

    jurisdiction = owned(
        db.query(TaxJurisdiction), TaxJurisdiction, user
    ).filter_by(id=data.get("jurisdiction_id"), is_active=True).first()
    if not jurisdiction:
        raise HTTPException(404, "Active tax jurisdiction not found.")

    on_date = parse_date(data.get("tax_date"), "tax_date", date.today())
    source_type = validate_source_owner(
        db, user, data.get("source_type", "manual"), data.get("source_id")
    )

    try:
        amount = Decimal(str(data["amount"]))
        if not amount.is_finite() or amount < 0:
            raise ValueError()
    except (KeyError, InvalidOperation, TypeError, ValueError):
        raise HTTPException(422, "A non-negative amount is required.")

    currency = validate_currency(data.get("currency"))
    context = dict(data.get("conditions_context") or {})
    if not isinstance(context, dict):
        raise HTTPException(422, "conditions_context must be a JSON object.")
    context.update({
        "source_type": source_type,
        "amount": amount,
        "currency": currency,
        "tax_date": on_date.isoformat(),
        "jurisdiction_id": jurisdiction.id,
    })

    rule = None
    if data.get("rule_id") is not None:
        rule = owned(
            db.query(TaxRule), TaxRule, user
        ).filter_by(
            id=data["rule_id"],
            jurisdiction_id=jurisdiction.id,
            is_active=True,
        ).first()
        if not rule:
            raise HTTPException(404, "Tax rule not found.")
    elif data.get("rate_id") is None and not data.get("rate_ids"):
        # Automatic rule selection: lowest priority number wins.
        candidates = owned(
            db.query(TaxRule), TaxRule, user
        ).filter_by(
            jurisdiction_id=jurisdiction.id,
            is_active=True,
        ).order_by(TaxRule.priority.asc(), TaxRule.id.asc()).all()

        for candidate in candidates:
            if matches_rule_conditions(candidate.conditions or {}, context):
                rule = candidate
                break

    treatment = rule.treatment if rule else data.get("treatment", "standard")
    price_mode = rule.price_mode if rule else data.get("price_mode", "exclusive")

    supported_treatments = {
        "standard", "exempt", "zero_rated", "out_of_scope", "reverse_charge"
    }
    if treatment not in supported_treatments:
        raise HTTPException(422, "Unsupported tax treatment.")
    if price_mode not in {"exclusive", "inclusive"}:
        raise HTTPException(422, "Unsupported price mode.")

    requested_ids = data.get("rate_ids")
    if requested_ids is None:
        requested_ids = [data["rate_id"]] if data.get("rate_id") is not None else []
    if not isinstance(requested_ids, list):
        raise HTTPException(422, "rate_ids must be an array.")
    if rule and rule.rate_id is not None and not requested_ids:
        requested_ids = [rule.rate_id]

    # A rule may define an ordered rate stack in its conditions JSON.
    if rule and not requested_ids:
        rule_rate_ids = (rule.conditions or {}).get("rate_ids", [])
        if rule_rate_ids:
            if not isinstance(rule_rate_ids, list):
                raise HTTPException(422, "Rule rate_ids must be an array.")
            requested_ids = rule_rate_ids

    if len(requested_ids) != len(set(requested_ids)):
        raise HTTPException(422, "Duplicate tax rate IDs are not allowed.")

    rates = []
    for rate_id in requested_ids:
        rate = owned(
            db.query(TaxRate), TaxRate, user
        ).filter_by(
            id=rate_id,
            jurisdiction_id=jurisdiction.id,
        ).first()
        if rate is None:
            raise HTTPException(404, f"Tax rate {rate_id} not found in this jurisdiction.")
        if not rate_is_valid(rate, on_date):
            raise HTTPException(422, f"Tax rate {rate_id} is not valid for this date.")
        rates.append(rate)

    if treatment == "standard" and not rates:
        raise HTTPException(422, "A standard tax calculation requires at least one tax rate.")

    rate_stack = [{
        "rate": rate.rate,
        "is_compound": bool(rate.is_compound),
        "rate_id": rate.id,
        "name": rate.name,
    } for rate in rates]

    # Reverse charge records zero net payable tax while preserving the
    # notional input/output amounts for compliance and reporting.
    reverse_charge_amount = Decimal("0")
    if treatment == "reverse_charge":
        notional = calculate_compound_tax(
            amount, rate_stack, price_mode, "standard"
        ) if rates else None
        if notional:
            reverse_charge_amount = notional["tax_amount"]

    result = calculate_compound_tax(
        amount, rate_stack or [{"rate": 0, "is_compound": False}],
        price_mode, treatment,
    )

    category_snapshots = []
    for rate in rates:
        if rate.category_id:
            category = owned(
                db.query(TaxCategory), TaxCategory, user
            ).filter_by(id=rate.category_id).first()
            if category is None:
                raise HTTPException(
                    422, "A selected tax rate references an unavailable category."
                )
            category_snapshots.append({
                "id": category.id,
                "code": category.code,
                "name": category.name,
            })

    details = {
        "price_mode": price_mode,
        "rule_id": rule.id if rule else None,
        "rate_ids": [rate.id for rate in rates],
        "rate_versions": {str(rate.id): rate.version for rate in rates},
        "tax_breakdown": [
            {key: str(value) if isinstance(value, Decimal) else value
             for key, value in component.items()}
            for component in result.get("tax_breakdown", [])
        ],
        "category_snapshots": category_snapshots,
    }

    if treatment == "reverse_charge":
        details["reverse_charge"] = {
            "input_tax": str(reverse_charge_amount),
            "output_tax": str(reverse_charge_amount),
            "net_tax": "0.00",
        }

    if data.get("save", True):
        # Application-level duplicate protection for linked source records.
        # Manual calculations are intentionally allowed to repeat.
        if source_type != "manual":
            existing = owned(
                db.query(TaxTransaction), TaxTransaction, user
            ).filter_by(
                source_type=source_type,
                source_id=data.get("source_id"),
                jurisdiction_id=jurisdiction.id,
                tax_date=on_date,
            ).first()
            if existing:
                raise HTTPException(
                    409,
                    f"A tax transaction already exists for this source and date (transaction {existing.id})."
                )

        rate_snapshot = sum(
            (Decimal(str(rate.rate)) for rate in rates),
            Decimal("0"),
        )

        tx = TaxTransaction(
            owner_id=user.id,
            jurisdiction_id=jurisdiction.id,
            rate_id=rates[0].id if rates else None,
            source_type=source_type,
            source_id=data.get("source_id"),
            tax_date=on_date,
            currency=currency,
            taxable_amount=result["taxable_amount"],
            tax_amount=result["tax_amount"],
            total_amount=result["total_amount"],
            rate_snapshot=rate_snapshot,
            treatment=treatment,
            details=details,
        )
        db.add(tx)
        db.flush()
        audit(db, user, "transaction", tx.id, "calculated", details)
        result["transaction_id"] = tx.id
        db.commit()

    return {
        key: (
            str(value) if isinstance(value, Decimal)
            else value
        )
        for key, value in result.items()
    }
@router.get("/transactions")
def list_transactions(
    start_date: date | None = None,
    end_date: date | None = None,
    jurisdiction_id: int | None = None,
    category_id: int | None = None,
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
):
    query = owned(db.query(TaxTransaction), TaxTransaction, user)
    if start_date:
        query = query.filter(TaxTransaction.tax_date >= start_date)
    if end_date:
        query = query.filter(TaxTransaction.tax_date <= end_date)
    if jurisdiction_id:
        query = query.filter(TaxTransaction.jurisdiction_id == jurisdiction_id)
    if category_id:
        query = query.join(
            TaxRate,
            (TaxRate.id == TaxTransaction.rate_id)
            & (TaxRate.owner_id == user.id),
        ).filter(TaxRate.category_id == category_id)
    return [
        serialize(x)
        for x in query.order_by(
            TaxTransaction.tax_date.desc(), TaxTransaction.id.desc()
        ).limit(500)
    ]


@router.get("/report")
def report(
    start_date: date,
    end_date: date,
    jurisdiction_id: int | None = None,
    category_id: int | None = None,
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
):
    if end_date < start_date:
        raise HTTPException(422, "End date cannot be earlier than start date.")

    query = owned(
        db.query(
            TaxTransaction.jurisdiction_id.label("jurisdiction_id"),
            TaxJurisdiction.name.label("jurisdiction_name"),
            TaxRate.category_id.label("category_id"),
            TaxCategory.code.label("category_code"),
            TaxCategory.name.label("category_name"),
            TaxTransaction.currency.label("currency"),
            TaxTransaction.treatment.label("treatment"),
            func.count(TaxTransaction.id).label("transaction_count"),
            func.sum(TaxTransaction.taxable_amount).label("taxable_total"),
            func.sum(TaxTransaction.tax_amount).label("tax_total"),
            func.sum(TaxTransaction.total_amount).label("gross_total"),
        ),
        TaxTransaction,
        user,
    ).join(
        TaxJurisdiction,
        (TaxJurisdiction.id == TaxTransaction.jurisdiction_id)
        & (TaxJurisdiction.owner_id == user.id),
    ).outerjoin(
        TaxRate,
        (TaxRate.id == TaxTransaction.rate_id)
        & (TaxRate.owner_id == user.id),
    ).outerjoin(
        TaxCategory,
        (TaxCategory.id == TaxRate.category_id)
        & (TaxCategory.owner_id == user.id),
    )

    query = query.filter(
        TaxTransaction.tax_date >= start_date,
        TaxTransaction.tax_date <= end_date,
    )

    if jurisdiction_id is not None:
        query = query.filter(TaxTransaction.jurisdiction_id == jurisdiction_id)
    if category_id is not None:
        query = query.filter(TaxRate.category_id == category_id)

    rows = query.group_by(
        TaxTransaction.jurisdiction_id,
        TaxJurisdiction.name,
        TaxRate.category_id,
        TaxCategory.code,
        TaxCategory.name,
        TaxTransaction.currency,
        TaxTransaction.treatment,
    ).order_by(
        TaxJurisdiction.name,
        TaxCategory.name,
        TaxTransaction.currency,
        TaxTransaction.treatment,
    ).all()

    return {
        "start_date": start_date.isoformat(),
        "end_date": end_date.isoformat(),
        "filters": {
            "jurisdiction_id": jurisdiction_id,
            "category_id": category_id,
        },
        "rows": [{
            "jurisdiction_id": row.jurisdiction_id,
            "jurisdiction": row.jurisdiction_name,
            "category_id": row.category_id,
            "category_code": row.category_code,
            "category": row.category_name,
            "currency": row.currency,
            "treatment": row.treatment,
            "transaction_count": row.transaction_count,
            "taxable_total": str(row.taxable_total or 0),
            "tax_total": str(row.tax_total or 0),
            "gross_total": str(row.gross_total or 0),
        } for row in rows],
    }
